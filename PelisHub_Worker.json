{
  "name": "PelisHub Worker",
  "description": "Catálogo TMDB + fuentes resueltas en Cloudflare Worker (OK.ru con la sesión de GrayJay)",
  "author": "cheito55",
  "authorUrl": "https://github.com/cheito55",
  "sourceUrl": "https://raw.githubusercontent.com/cheito55/PlayP-Worker/main/PelisHub_Worker.json",
  "repositoryUrl": "https://github.com/cheito55/PlayP-Worker",
  "scriptUrl": "./PelisHub_Worker.js",
  "version": 9,
  "iconUrl": "",
  "id": "b7a2e4c1-3d5f-4e8a-9c26-1f0d7a5b8e99",
  "scriptSignature": "",
  "scriptPublicKey": "",
  "packages": ["Http"],
  "allowEval": false,
  "allowUrls": ["everywhere"],
  "authentication": {
    "loginUrl": "https://ok.ru/dk?st.cmd=anonymMain",
    "completionUrl": "https://ok.ru/feed",
    "cookiesToFind": ["JSESSIONID", "AUTHCODE", "domain_sid"]
  },
  "settings": [
    {
      "variable": "apiBase",
      "name": "URL del Worker",
      "description": "Ejemplo: https://pelishub-api.xxxxx.workers.dev",
      "type": "String",
      "default": "https://pelishub.cheito55.workers.dev/"
    },
    {
      "variable": "apiKey",
      "name": "API key (opcional)",
      "description": "Solo si definiste API_TOKEN en el Worker",
      "type": "String",
      "default": ""
    },
    {
      "variable": "okruSession",
      "name": "OK.ru con mi sesión",
      "description": "Busca videos en OK.ru usando la sesión iniciada en este source",
      "type": "Boolean",
      "default": "true"
    },
    {
      "variable": "servidoresPlus",
      "name": "Servidores Plus",
      "description": "Odysee + Dailymotion + Archive.org primero",
      "type": "Boolean",
      "default": "false"
    },
    {
      "variable": "serverMode",
      "name": "Modo de servidores",
      "description": "Cuántos servidores buscar (Rápido ~3, Normal ~5, Completo ~8)",
      "type": "Dropdown",
      "default": "0",
      "options": ["Rápido", "Normal", "Completo"]
    },
    {
      "variable": "extraSites",
      "name": "Sitios extra",
      "description": "Catálogo PelisJuanita/JKAnime en la búsqueda + sitios WordPress extra",
      "type": "Boolean",
      "default": "false"
    },
    {
      "variable": "debugMode",
      "name": "Modo diagnóstico",
      "description": "Muestra el log del worker y de OK.ru en la descripción",
      "type": "Boolean",
      "default": "false"
    }
  ]
}
