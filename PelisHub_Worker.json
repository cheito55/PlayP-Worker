{
  "name": "PelisHub Worker",
  "description": "Catalogo TMDB + fuentes en Cloudflare Worker",
  "author": "cheito55",
  "authorUrl": "https://github.com/cheito55",
  "sourceUrl": "https://raw.githubusercontent.com/cheito55/PlayP-Worker/main/PelisHub_Worker.json",
  "repositoryUrl": "https://github.com/cheito55/PlayP-Worker",
  "scriptUrl": "./PelisHub_Worker.js",
  "version": 10,
  "iconUrl": "",
  "id": "b7a2e4c1-3d5f-4e8a-9c26-1f0d7a5b8e99",
  "scriptSignature": "",
  "scriptPublicKey": "",
  "packages": [
    "Http"
  ],
  "allowEval": false,
  "allowUrls": [
    "everywhere"
  ],
  "settings": [
    {
      "variable": "apiBase",
      "name": "URL del Worker",
      "description": "https://pelishub.cheito55.workers.dev",
      "type": "String",
      "default": "https://pelishub.cheito55.workers.dev"
    },
    {
      "variable": "apiKey",
      "name": "API key (opcional)",
      "description": "Solo si hay API_TOKEN en el Worker",
      "type": "String",
      "default": ""
    },
    {
      "variable": "servidoresPlus",
      "name": "Servidores Plus",
      "description": "Odysee + Dailymotion + Archive",
      "type": "Boolean",
      "default": "false"
    },
    {
      "variable": "serverMode",
      "name": "Modo de servidores",
      "description": "Rapido / Normal / Completo",
      "type": "Dropdown",
      "default": "0",
      "options": [
        "Rapido",
        "Normal",
        "Completo"
      ]
    },
    {
      "variable": "extraSites",
      "name": "Sitios extra",
      "description": "Mas proveedores",
      "type": "Boolean",
      "default": "false"
    },
    {
      "variable": "debugMode",
      "name": "Modo diagnostico",
      "description": "Muestra debug del worker",
      "type": "Boolean",
      "default": "false"
    }
  ]
}
