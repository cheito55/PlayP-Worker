{
  "name": "PelisHub Worker",
  "description": "Catálogo TMDB + fuentes resueltas en Cloudflare Worker",
  "author": "cheito55",
  "authorUrl": "https://github.com/cheito55",
  "sourceUrl": "https://raw.githubusercontent.com/TU_USUARIO/TU_REPO/main/PelisHub_Worker.json",
  "repositoryUrl": "https://github.com/TU_USUARIO/TU_REPO",
  "scriptUrl": "./PelisHub_Worker.js",
  "version": 1,
  "iconUrl": "",
  "id": "b7a2e4c1-3d5f-4e8a-9c26-1f0d7a5b8e99",
  "scriptSignature": "",
  "scriptPublicKey": "",
  "packages": ["Http"],
  "allowEval": false,
  "allowUrls": ["everywhere"],
  "settings": [
    {
      "variable": "apiBase",
      "name": "URL del Worker",
      "description": "Ejemplo: https://pelishub-api.xxxxx.workers.dev",
